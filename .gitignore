# When user run `git lfs track "**/snapshots/**/*.png"` it creates .gitattributes
# To avoid errors using this git repo for users who don't need Git LFS we do not store .gitattributes in git
.gitattributes

# When user run `git lfs track "**/snapshots/**/*.png"` it creates .git/hooks/pre-push
# To avoid errors using this git repo for users who don't need Git LFS we do not store Git LFS pre-push in git
/git_hooks/pre-push
